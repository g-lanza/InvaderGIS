{
  "name": "invadergis",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "InvaderGIS — the Medieval Systems Atlas. A custom GIS for 500–1500 CE historical research. A product of Gavin Lanza.",
  "scripts": {
    "predev": "npm run bake",
    "dev": "vite",
    "prebuild": "npm run bake",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:safe": "npm run validate && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "migrate": "node scripts/migrate/migrate.mjs",
    "validate": "node scripts/validate/validate.mjs",
    "bake": "node scripts/build/bake-manifests.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/spectral": "^5.2.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
