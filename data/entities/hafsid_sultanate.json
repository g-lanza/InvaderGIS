  "lifecycle_phases": [
    {
      "phase": "establishment",
      "years": "1229–1277",
      "description": "Abu Zakariya breaks from the Almohads; his son al-Mustansir briefly claims the title of caliph (1229) after the Almohad retreat; Hafsids establish Tunis as a major Mediterranean port and Islamic cultural center",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ]
    },
    {
      "phase": "zenith",
      "years": "1277–1370",
      "description": "Height of Hafsid power; Tunis becomes a major Mediterranean trading city competing with Venice and Genoa; Ibn Khaldun serves as court historian; significant trans-Saharan gold trade; repels Aragonese crusading expeditions",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ]
    },
    {
      "phase": "decline_and_ottoman_absorption",
      "years": "1370–1574",
      "description": "Marinid and internal succession pressures weaken the sultanate; Spanish Habsburg forces briefly occupy Tunis (1535); Ottoman naval power dominates the Mediterranean; Sinan Pasha conquers Tunisia 1574",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "almohad_succession",
      "layer": "external_political",
      "description": "As governors of Ifriqiya under the Almohads, the Hafsids inherited a functioning administrative apparatus, tax base, and military when Almohad central power collapsed",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ]
    },
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "Tunisia's position as the natural crossroads of the central Mediterranean, equidistant from Sicily, Sardinia, and Egypt, made Tunis a major entrepôt for Italian, Spanish, and sub-Saharan merchants",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ],
      "tag_prose": "tunisian_trade_position"
    },
    {
      "tag": "caliphal_claim",
      "layer": "ideology_religion",
      "description": "After the Mongol destruction of Baghdad (1258), the Hafsids briefly claimed the caliphate, attracting scholars and giving them prestige across the Sunni world",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "iberian_pressure",
      "layer": "military_security",
      "description": "Spanish Habsburg forces under Charles V captured Tunis (1535), installing a Spanish client; though the Hafsids were nominally restored, the sultanate became dependent on external powers",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ]
    },
    {
      "tag": "external_military_pressure",
      "layer": "external_political",
      "description": "Ottoman naval supremacy in the Mediterranean following Lepanto (1571) made North African states difficult to defend; the Ottomans incorporated Tunisia as a province rather than tolerating an independent sultanate",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ],
      "tag_prose": "ottoman_expansion"
    },
    {
      "tag": "succession_crisis",
      "layer": "dynastic_legitimacy",
      "description": "Repeated succession wars between Hafsid princes, often involving Aragonese or Marinid interference, prevented stable governance and weakened the dynasty over its final century",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q752662",
          "url": "https://www.wikidata.org/wiki/Q752662"
        },
        {
          "type": "wikipedia",
          "label": "Hafsid Sultanate",
          "url": "https://en.wikipedia.org/wiki/Hafsid_dynasty"
        }
      ],
      "tag_prose": "succession_conflicts"
    }
  ],
