  "lifecycle_phases": [
    {
      "phase": "mamluk_dynasty",
      "years": "1206–1290",
      "description": "Slave generals (Mamluks) from Ghurid Afghanistan establish the sultanate; Iltutmish consolidates power and gains Abbasid recognition; repels early Mongol raids; Razia Sultana (1236–1240) first female ruler of a Muslim state in South Asia",
      "sources": [
        {
          "type": "wikidata",
