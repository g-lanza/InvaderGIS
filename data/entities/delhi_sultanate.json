  "rise_factors": [
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "Turkic horse archers and mounted heavy cavalry from Central Asia had decisive advantages over Indian infantry-based armies and war elephants; systematic fortification of Delhi",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q229411",
          "url": "https://www.wikidata.org/wiki/Q229411"
        },
        {
          "type": "wikipedia",
