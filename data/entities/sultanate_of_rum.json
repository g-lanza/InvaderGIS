  "lifecycle_phases": [
    {
      "phase": "establishment",
      "years": "1077–1176",
      "description": "Suleiman ibn Qutulmish founds the sultanate after Manzikert (1071) opens Anatolia to Turkic settlement; capital at Nicaea; expelled from Nicaea by First Crusade (1096) and Byzantine recovery; moves capital to Konya (Iconium)",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
