        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "mongol_kosedag_defeat",
      "direction": "decline",
      "description": "The Battle of Köse Dağ (1243), in which Mongol forces destroyed the Seljuk army, made the sultanate a Mongol vassal overnight. The subsequent Mongol tax burden, combined with loss of independent military command, hollowed out the sultanate permanently.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
          "url": "https://www.wikidata.org/wiki/Q975405"
        },
