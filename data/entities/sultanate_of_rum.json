  "decline_factors": [
    {
      "tag": "military_technological_advantage",
      "layer": "military_security",
      "description": "Mongol army's overwhelming numerical and tactical superiority at Köse Dağ (1243) left the sultanate unable to resist; the sultan fled the battlefield, permanently destroying Rum's military credibility",
      "sources": [
        {
