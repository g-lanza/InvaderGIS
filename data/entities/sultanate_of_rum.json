        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_advantage",
      "layer": "geography_territory",
      "description": "Control of central Anatolian plateau gave command of overland trade routes between Europe and Asia; Konya's position made it a major commercial hub generating substantial transit revenues",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
          "url": "https://www.wikidata.org/wiki/Q975405"
        },
        {
          "type": "wikipedia",
          "label": "Sultanate of Rum",
          "url": "https://en.wikipedia.org/wiki/Sultanate_of_Rum"
        }
      ]
    },
    {
      "tag": "rival_fragmentation",
      "layer": "external_political",
      "description": "Byzantine Empire weakened by internal conflicts and the shock of Manzikert could not mount sustained reconquest; Crusader states and other Seljuk successor states provided buffer zones",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
          "url": "https://www.wikidata.org/wiki/Q975405"
        },
        {
          "type": "wikipedia",
          "label": "Sultanate of Rum",
          "url": "https://en.wikipedia.org/wiki/Sultanate_of_Rum"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "The Sultanate controlled the main Anatolian caravan routes between Central Asia and Mediterranean ports. The sultans built caravanserai networks (still visible today) every 30km across Anatolia, supporting and taxing commerce.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
          "url": "https://www.wikidata.org/wiki/Q975405"
        },
        {
          "type": "wikipedia",
          "label": "Sultanate of Rum",
          "url": "https://en.wikipedia.org/wiki/Sultanate_of_Rum"
        }
      ],
      "tag_prose": "anatolian_trade_routes"
    },
    {
      "layer": "ideology_religion",
      "tag": "konya_cosmopolitan_center",
      "direction": "rise",
      "description": "Konya (Iconium) under Alaeddin Kayqubad I became a major cultural center. The mystical poet Rumi (1207–1273) based his Mevlevi Sufi order here; the city attracted scholars and craftsmen from across the Islamic world.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
          "url": "https://www.wikidata.org/wiki/Q975405"
        },
        {
          "type": "wikipedia",
          "label": "Sultanate of Rum",
          "url": "https://en.wikipedia.org/wiki/Sultanate_of_Rum"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "military_organizational_advantage",
      "direction": "rise",
      "description": "The Battle of Myriokephalon (1176), Seljuk defeat of Byzantine Emperor Manuel I's invasion, permanently ended Byzantine attempts to reconquer Anatolia. This strategic victory secured Seljuk permanence in the heartland of the former Roman Empire.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
          "url": "https://www.wikidata.org/wiki/Q975405"
        },
        {
