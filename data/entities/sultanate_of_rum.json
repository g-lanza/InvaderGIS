      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "mongol_ilkhanate_subordination",
      "direction": "decline",
      "description": "After Köse Dağ, Seljuk sultans required Ilkhanate confirmation of their throne. Mongol overseers (shahnas) controlled revenues and military appointments. The sultanate became a fiscal extraction mechanism for the Ilkhanate rather than an independent polity.",
