        }
      ]
    },
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "Mongol overlords manipulated Seljuk succession to keep the sultanate weak; rival princes backed by different Mongol factions fought civil wars that accelerated fragmentation into beyliks",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q975405",
