        }
      ],
      "tag_prose": "myriokephalon_victory_1176"
    },
    {
      "layer": "governance_institutional",
      "tag": "alaeddin_kayqubad_hegemony",
      "direction": "rise",
      "description": "Alaeddin Kayqubad I (r.1220–37) was the sultanate's high point: expanding to the Black Sea coast, building Alanya, patronizing major architectural projects, and administering a cosmopolitan multi-ethnic state with unusual competence.",
      "sources": [
        {
