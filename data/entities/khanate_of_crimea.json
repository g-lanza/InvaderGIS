  "rise_factors": [
    {
      "tag": "rival_fragmentation",
      "layer": "external_political",
      "description": "Fragmentation of the Golden Horde created a power vacuum in Crimea that the Giray dynasty filled.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ]
    },
    {
      "tag": "mobility_advantage",
      "layer": "military_security",
      "description": "Crimean Tatar cavalry maintained high military effectiveness for raiding and steppe warfare.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ]
    },
    {
      "tag": "external_alliance",
      "layer": "external_political",
      "description": "Ottoman suzerainty from 1475 provided naval and diplomatic backing against competing Tatar khanates.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Crimean Tatar slave raids into Poland, Lithuania, Russia, and the Caucasus captured an estimated 2-3 million people over two centuries. The sale of captives in Ottoman markets (especially in Kaffa/Caffa) generated the primary revenue of the khanate's economy.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ],
      "tag_prose": "slave_trade_revenues"
    },
    {
      "layer": "governance_institutional",
      "tag": "ottoman_vassal_protection",
      "direction": "rise",
      "description": "Ottoman suzerainty (from 1475) provided military protection while the khanate retained internal autonomy. This arrangement gave Crimea security against Muscovite and Polish-Lithuanian military pressure without the costs of full Ottoman administrative integration.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ]
    },
    {
      "layer": "geography_territory",
      "tag": "mobility_advantage",
      "direction": "rise",
      "description": "Crimean Tatar horsemen exploited steppe geography for lightning raids: light cavalry could cover 100 miles per day, devastating settlements before defenders could concentrate. The northern steppe highways enabled rapid power projection across a vast area.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ],
      "tag_prose": "steppe_nomad_mobility"
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Caffa (Feodosiya) under Genoese and then Crimean control was the Black Sea's primary slave market, with Crimean Tatar raids into Poland, Russia, and Ukraine delivering hundreds of thousands of captives for sale to Ottoman buyers annually.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q160440",
          "url": "https://www.wikidata.org/wiki/Q160440"
        },
        {
          "type": "wikipedia",
          "label": "Crimean Khanate",
          "url": "https://en.wikipedia.org/wiki/Crimean_Khanate"
        }
      ],
      "tag_prose": "slave_trade_kaffa"
    }
  ],
  "decline_factors": [
