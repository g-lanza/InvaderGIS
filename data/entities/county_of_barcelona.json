  "lifecycle_phases": [
    {
      "phase": "frankish_march",
      "years": "801–988",
      "description": "Charlemagne's forces capture Barcelona (801) from the Umayyads, establishing it as the capital of the Spanish March, a Frankish frontier zone. The counts of Barcelona hold the position under Frankish suzerainty; Guifré el Pilós (the Hairy, 878–897) becomes the first hereditary count of Barcelona, founding the Catalan dynasty. The counts increasingly act independently as Carolingian power collapses.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ]
    },
    {
      "phase": "catalan_expansion",
      "years": "988–1162",
      "description": "Count Borrell II refuses to recognize Hugh Capet as king (988), effectively making Catalonia independent of France. The counts expand south through the Reconquista, capturing Tarragona and the lower Ebro. Ramon Berenguer III (1082–1131) marries the heiress of Provence, extending Catalan control into southern France. His son Ramon Berenguer IV marries the heiress of Aragon (1137), creating the Crown of Aragon.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "Barcelona's Mediterranean port gave Catalonia access to the trade networks of the western Mediterranean; combined with Provence (after 1112), the county controlled the coastal routes from the Rhône to the Ebro, positioning it to become the commercial heart of the Crown of Aragon",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ]
    },
    {
      "tag": "mobility_advantage",
      "layer": "economic_commercial",
      "description": "Barcelona's merchants created a Mediterranean commercial network rivaling Genoa; the Llibre del consolat de mar (c. 1272) codified maritime commercial law adopted across the Mediterranean; Catalan trading colonies in Sicily, Sardinia, and Greece generated wealth channeled through Barcelona",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ],
      "tag_prose": "catalan_maritime_expansion"
    },
    {
      "layer": "economic_commercial",
      "tag": "mobility_advantage",
      "direction": "rise",
      "description": "Barcelona's harbor gave the county direct access to Mediterranean trade. Catalan merchants became dominant in western Mediterranean commerce (Genoa-Pisa competition zone), establishing trading posts from Sardinia to Sicily.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ],
      "tag_prose": "mediterranean_maritime_position"
    },
    {
      "layer": "dynastic_legitimacy",
      "tag": "dynastic_consolidation",
      "direction": "rise",
      "description": "The marriage of Ramon Berenguer IV to Petronilla of Aragon (1137) united the county with Aragon's territory. This dynastic union created the Crown of Aragon, with Barcelona providing commercial-maritime resources and Aragon providing territorial depth.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ],
      "tag_prose": "aragonese_union_leverage"
    },
    {
      "layer": "governance_institutional",
      "tag": "carolingian_march_origin",
      "direction": "rise",
      "description": "Barcelona originated as a Carolingian frontier march established to defend against Moorish raids. This military origin gave its counts institutional independence: they developed their own administration without strong royal oversight.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "usages_of_barcelona_law",
      "direction": "rise",
      "description": "The Usatges de Barcelona (c.1060), one of Europe's earliest feudal law codes, codified rights and obligations, reducing arbitrary lordship and attracting settlers to Catalan frontier expansion zones.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
        {
          "type": "wikipedia",
          "label": "County of Barcelona",
          "url": "https://en.wikipedia.org/wiki/County_of_Barcelona"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "carolingian_march",
      "direction": "rise",
      "description": "Established as a Carolingian march against the Umayyads around 801, Barcelona's counts gradually became independent as Carolingian power collapsed, with Wifred the Hairy refusing to pay homage in 878 and founding the hereditary Catalan comital dynasty.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1233672",
          "url": "https://www.wikidata.org/wiki/Q1233672"
        },
