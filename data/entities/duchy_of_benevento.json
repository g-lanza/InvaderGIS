  "lifecycle_phases": [
    {
      "phase": "lombard_duchy",
      "years": "571–774",
      "description": "The Duchy of Benevento is established by the Lombard general Zotto (571) as the southernmost Lombard territory, centered on Benevento in southern Italy. Unlike the northern Lombard kingdom, it survives the Frankish conquest (774) as an independent Lombard principality, the only Lombard polity outside Carolingian control. It serves as a buffer between the Byzantine heel and toe of Italy and the Frankish north.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    },
    {
      "phase": "fragmentation",
      "years": "774–1077",
      "description": "After surviving as an independent principality, Benevento fragments in the 9th century into competing principalities (Salerno, Capua) as Arab raids destabilize the south. The Normans arrive as mercenaries in the early 11th century and progressively conquer the Lombard principalities; Robert Guiscard receives papal investiture over Apulia, Calabria, and Capua (1059). The Battle of Civitate (1053), where Norman forces defeat and capture Pope Leo IX himself, shows the Norman dominance of southern Italy.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "Benevento's position in the Apennine mountains gave it defensible terrain against both Byzantine coastal forces and Frankish Alpine invaders; the duchy's geographic isolation from both the Frankish and Byzantine heartlands allowed it to survive as an independent entity for centuries",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    },
    {
      "tag": "geographic_advantage",
      "layer": "geography_territory",
      "description": "Benevento controlled the main routes between northern and southern Italy; Lombard retention of this territory created a persistent obstacle to Carolingian and papal dominance of the Italian peninsula",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ],
      "tag_prose": "strategic_position"
    },
    {
      "layer": "geography_territory",
      "tag": "southern_apennine_bastion",
      "direction": "rise",
      "description": "The Duchy of Benevento's Apennine mountain base made it virtually impregnable to Carolingian invasion from the north. Mountains that stopped Charlemagne's armies kept Benevento as the longest-surviving Lombard successor state.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "geographic_defensibility",
      "direction": "rise",
      "description": "Benevento's position between Frankish Italy and Byzantine southern Italy gave it value to both powers as a buffer. This strategic ambiguity enabled diplomatic leverage: neither power wanted the other to absorb Benevento.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ],
      "tag_prose": "byzantine_buffer_value"
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Amalfi (nominally Benevento's tributary before its independence) pioneered Mediterranean long-distance trade. Benevento's connections with this commercial network generated revenues unusual for an inland polity.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ],
      "tag_prose": "tyrrhenian_trade_revenues"
    }
  ],
  "decline_factors": [
    {
      "tag": "external_military_pressure",
      "layer": "military_security",
      "description": "Norman mercenaries, initially hired to defend the Lombard principalities against Byzantine and Arab raids, progressively shifted from employees to conquerors; the military superiority of Norman cavalry over Lombard infantry proved decisive",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    },
    {
      "tag": "papal_intervention",
      "layer": "external_political",
      "description": "The papacy purchased Benevento from the Holy Roman Empire (1051) and steadily absorbed Lombard principalities; Norman conquest of southern Italy eliminated the independent Lombard principalities that had shielded Benevento's autonomy",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "division_of_839",
      "direction": "decline",
      "description": "The Treaty of 849 divided Benevento between the Duchy of Benevento proper and the new Principality of Salerno. This fratricidal partition permanently weakened Lombard southern Italy's resistance to Norman and Byzantine pressure.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "external_military_pressure",
      "direction": "decline",
      "description": "Norman adventurers recruited as mercenaries progressively seized Beneventan territory from the 1020s onward. By 1077, Robert Guiscard had absorbed most of the duchy, replacing Lombard with Norman power in southern Italy.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q267816",
          "url": "https://www.wikidata.org/wiki/Q267816"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Benevento",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Benevento"
        }
      ],
      "tag_prose": "norman_conquest_pressure"
    },
    {
      "layer": "military_security",
      "tag": "external_military_pressure",
      "direction": "decline",
      "description": "Charlemagne's campaigns against the Lombards left Benevento as the last Lombard state; the duchy survived by paying tribute and playing the Franks against Byzantium, but lost territory steadily to both powers throughout the 9th century.",
      "sources": [
        {
          "type": "wikidata",
