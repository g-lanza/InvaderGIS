  "lifecycle_phases": [
    {
      "phase": "lusignan_kingdom",
      "years": "1192–1374",
      "description": "Richard I of England conquers Cyprus from the Byzantine governor Isaac Komnenos (1191) during the Third Crusade and sells it to the Lusignan family. Cyprus becomes the last functioning Crusader state after the fall of Acre (1291), serving as a base for trade with the Mamluk sultanate. The Lusignan kings style themselves also as kings of Jerusalem and Armenia, maintaining Crusader pretensions.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "phase": "venetian_protectorate",
      "years": "1374–1489",
      "description": "Genoese forces sack Famagusta (1373) after a dispute; Genoa holds the city for 90 years. The Lusignan king James II marries the Venetian Caterina Cornaro (1472) to gain Venetian naval support against the Genoese; his death and that of their infant son leaves Caterina as queen. Venice pressures her to abdicate (1489), adding Cyprus to its island empire.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_advantage",
      "layer": "geography_territory",
      "description": "Cyprus's position at the eastern Mediterranean crossroads made it the essential staging point for trade between Europe and the Levant; after the mainland Crusader states fell, Cyprus became the mandatory transit point for merchants trading with Egypt and Syria",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "Cyprus produced sugar, cotton, carob, and fine silks for export; its position as the last Crusader state made Famagusta the destination port for Silk Road goods transshipping from Syrian ports, making it the wealthiest city per capita in the 14th-century Mediterranean",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "tag": "crusader_logistics_hub",
      "layer": "economic_commercial",
      "description": "Cyprus became the primary staging base for crusades after 1191; the island's harbors provisioned fleets, its markets exchanged currency, and its castles sheltered crusading leaders, generating revenue and strategic importance that the Lusignan kings exploited",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "tag": "sugar_and_wine_exports",
      "layer": "economic_commercial",
      "description": "Cypriot sugar (from Kolossi and Episkopi) and the renowned Commandaria wine were luxury exports in high demand across Europe; the plantation economy, operated with Syrian and local labor, generated the agricultural surplus that funded the kingdom",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "tag": "lusignan_court_culture",
      "layer": "ideology_religion",
      "description": "The Lusignan court synthesized French chivalric culture with Byzantine and Levantine traditions; Nicosia became a cultural center where French, Greek, Genoese, and Armenian aristocrats interacted, and the kingdom's legal system blended crusader law with Cypriot custom",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "layer": "geography_territory",
      "tag": "crusader_supply_hub",
      "direction": "rise",
      "description": "Cyprus under the Lusignan dynasty became the essential supply and logistics base for crusading expeditions to the Holy Land, its sheltered harbors and abundant grain making it indispensable to any eastern Mediterranean military operation.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "The death of James II and his infant heir without adult successors allowed Venice to pressure Caterina Cornaro into abdicating; the Lusignan dynasty's demographic failure ended the kingdom",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "tag": "genoese_venetian_rivalry",
      "layer": "economic_commercial",
      "description": "Cyprus was a battleground for Genoese-Venetian commercial rivalry; the Genoese occupation of Famagusta (1374–1464) cut the kingdom off from its premier trading port and reduced customs revenue to a fraction of earlier levels",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "tag": "mamluk_tribute_demand",
      "layer": "military_security",
      "description": "After the Mamluk sack of Limassol (1425–1426) and the capture of King Janus, Cyprus paid annual tribute to Egypt; the tribute burden drained royal finances and the humiliation undermined Lusignan prestige, encouraging Venetian economic encroachment",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "venetian_ottoman_war",
      "direction": "decline",
      "description": "The Ottoman conquest of Cyprus in 1571, including the brutal torture and execution of Venetian commander Marcantonio Bragadin, ended Lusignan-Venetian rule and shocked all of Europe, precipitating the Holy League that fought Lepanto.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q213638",
          "url": "https://www.wikidata.org/wiki/Q213638"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Cyprus",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Cyprus"
        }
      ]
    }
  ],
