  "rise_factors": [
    {
      "tag": "almohad_collapse",
      "layer": "external_political",
      "description": "The Almohad Caliphate's military defeats in Iberia and internal religious schisms left Morocco ungoverned; the Marinids filled the vacuum with disciplined Zenata Berber cavalry",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q582861",
          "url": "https://www.wikidata.org/wiki/Q582861"
        },
        {
          "type": "wikipedia",
          "label": "Marinid Dynasty",
          "url": "https://en.wikipedia.org/wiki/Marinid_dynasty"
        }
      ]
    },
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "Morocco's position at the northern terminus of trans-Saharan gold and slave routes gave the Marinids revenues that funded their building program and military campaigns",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q582861",
          "url": "https://www.wikidata.org/wiki/Q582861"
