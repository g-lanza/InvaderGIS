  "rise_factors": [
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "Alpine terrain gave Swiss cantons decisive tactical advantage; pike-armed infantry in mountain passes could defeat mounted knights.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
