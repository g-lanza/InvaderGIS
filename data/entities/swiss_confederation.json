        }
      ]
    },
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "Swiss pike squares at Morgarten (1315), Sempach (1386), and Grandson (1476) proved the most effective infantry system in Europe.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ]
    },
    {
      "tag": "ideological_unification",
      "layer": "ideology_religion",
      "description": "Everlasting League oath-based confederation built genuine solidarity among cantons against Habsburg centralization.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "pike_formation_innovation",
      "direction": "rise",
      "description": "Swiss infantry pike squares (Gevierthaufen) proved devastating against feudal cavalry. At Morgarten (1315), Laupen (1339), Sempach (1386), and Näfels (1388), Swiss pikemen destroyed Habsburg and Burgundian cavalry armies, making Swiss military service the most valued in Europe.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ]
    },
    {
      "layer": "geography_territory",
      "tag": "geographic_defensibility",
      "direction": "rise",
      "description": "The Gotthard Pass (opened c.1230) became the primary trans-Alpine route for Italian-German trade. Swiss cantons controlling the pass collected tolls and denied passage to enemies, generating both revenue and strategic leverage.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ],
      "tag_prose": "alpine_pass_control"
    },
    {
      "layer": "governance_institutional",
      "tag": "federal_oath_covenant",
      "direction": "rise",
      "description": "The Eternal Alliance (Ewiger Bund, 1291) established a mutual defense compact between Uri, Schwyz, and Unterwalden. This covenant model, extended to subsequent cantons, created a confederation that preserved local autonomy while enabling collective defense.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Swiss military reputation generated enormous mercenary income. From the mid-15th century, Swiss cantons negotiated collective mercenary treaties (Reisläuferei) with France, the papacy, and Italian states, bringing silver into an otherwise resource-poor mountain economy.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ],
      "tag_prose": "mercenary_service_revenues"
    },
    {
      "layer": "military_security",
      "tag": "military_organizational_advantage",
      "direction": "rise",
      "description": "Swiss peasant infantry at Morgarten (1315) defeated Habsburg heavy cavalry by exploiting the narrow mountain pass, demonstrating that organized communal foot soldiers could defeat mounted nobility, a lesson that transformed European warfare.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q435583",
          "url": "https://www.wikidata.org/wiki/Q435583"
        },
        {
          "type": "wikipedia",
          "label": "Swiss Confederation",
          "url": "https://en.wikipedia.org/wiki/Old_Swiss_Confederacy"
        }
      ],
      "tag_prose": "battle_of_morgarten"
    }
  ],
