  "lifecycle_phases": [
    {
      "phase": "foundation",
      "years": "939–1066",
      "description": "Alan II Barbetorte (939) drives the Vikings from Brittany and establishes the duchy after a generation of Viking occupation. Brittany maintains its Celtic language, law, and customs distinct from Frankish France. The dukes maneuver between the Kings of France and the Duchy of Normandy, maintaining nominal French suzerainty while exercising effective independence.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    },
    {
      "phase": "breton_succession_war",
      "years": "1341–1365",
      "description": "The War of the Breton Succession (1341–1365) is fought between the English-backed John of Montfort and the French-backed Charles of Blois; it becomes a major theater of the Hundred Years' War. John IV of Montfort wins with English support at Auray (1364); the subsequent dukes balance English alliance with French sovereignty. The Duchy is ultimately annexed by France when Duchess Anne of Brittany marries successive French kings (1491, 1499).",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "The Breton peninsula, surrounded by sea on three sides, required any invader to fight through a narrow land approach defended by the Breton marches; Brittany's Celtic maritime tradition gave it naval access that landlocked rivals lacked",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    },
    {
      "tag": "geographic_advantage",
      "layer": "geography_territory",
      "description": "The Armorican peninsula's position, surrounded on three sides by sea, made military conquest extremely costly; Breton geography also created a distinctive cultural space that preserved Celtic language, saints' cults, and legal customs",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ],
      "tag_prose": "geographic_isolation"
    },
    {
      "tag": "naval_capacity",
      "layer": "military_security",
      "description": "Breton seafarers dominated the Atlantic trade between England, France, Spain, and the northern seas; the duchy's commercial prosperity derived from maritime expertise that made it a valuable ally for both England and France",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    },
    {
      "layer": "ideology_religion",
      "tag": "celtic_identity_resistance",
      "direction": "rise",
      "description": "Breton language, law, and ecclesiastical tradition distinguished Brittany from Frankish Francia. This Celtic identity provided cultural resistance to absorption and gave Breton nobles a distinct political identity that justified autonomy claims against both French and Norman overlords.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    },
    {
      "layer": "geography_territory",
      "tag": "atlantic_peninsula_position",
      "direction": "rise",
      "description": "The Breton peninsula's Atlantic coastline enabled maritime commerce and fishing that supplemented inland agriculture. Breton sailors developed expertise in Atlantic navigation that foreshadowed later Atlantic exploration.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "independence_from_carolingians",
      "direction": "rise",
      "description": "Nominoë's victory at Ballon (845) ended Carolingian attempts to control Brittany directly. Brittany's subsequent status as a frontier march, allied to but not absorbed by Francia, gave it institutional independence that became increasingly formal.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "The War of Breton Succession drew both England and France into Breton politics, ensuring that whoever won was a client of a major power; the subsequent dukes' need to balance between France and England prevented truly independent Breton policy",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Brittany",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Brittany"
        }
      ]
    },
    {
      "tag": "succession_absorbed",
      "layer": "dynastic_legitimacy",
      "description": "Anne of Brittany's marriages to Charles VIII (1491) then Louis XII (1499) of France brought Brittany into French dynastic orbit; her daughter Claude married Francis I, and Brittany was formally incorporated into France (1532)",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q71747",
          "url": "https://www.wikidata.org/wiki/Q71747"
        },
        {
          "type": "wikipedia",
