 "rise_factors": [
  {
   "tag": "military_organizational_advantage",
   "layer": "military_security",
   "description": "Saladin combined Kurdish tribal forces with professional Syrian and Egyptian armies into a coherent command structure; his siege warfare ended Crusader castle dominance at key fortresses",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "tag": "religious_legitimacy",
   "layer": "ideology_religion",
   "description": "Saladin cultivated the image of the ideal Sunni ruler defending Islam against Crusaders and the heretical Fatimids; retaking Jerusalem in 1187 gave enormous religious prestige throughout the Islamic world",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "tag": "rival_fragmentation",
   "layer": "external_political",
   "description": "Exploited the Crusader states' internal succession crises (Baldwin IV's leprosy, disputed regencies) and the Fatimid caliphate's weakness to build a unified Egyptian-Syrian power base",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "layer": "governance_institutional",
   "tag": "dynastic_consolidation",
   "direction": "rise",
   "description": "Saladin eliminated Fatimid Shiism from Egypt (1171) and reunited Egypt, Syria, and Mesopotamia under Sunni rule for the first time since the 10th century. This reunification concentrated resources that had been divided between rival caliphates.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ],
   "tag_prose": "saladin_sunni_reunification"
  },
  {
   "layer": "military_security",
   "tag": "hattin_crusader_destruction",
   "direction": "rise",
   "description": "The Battle of Hattin (1187) annihilated the Kingdom of Jerusalem's field army and captured its True Cross relic. The subsequent capture of Jerusalem triggered the Third Crusade but demonstrated that sustained Muslim military mobilization could reverse Crusader territorial gains.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "layer": "external_political",
   "tag": "jerusalem_negotiated_return",
   "direction": "rise",
   "description": "The Treaty of Jaffa (1229), Al-Kamil's negotiation with Frederick II, returned Jerusalem without military loss. This diplomatic flexibility, sacrificing territory for peace to address internal threats, demonstrated sophisticated foreign policy realism.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  }
 ],
 "decline_factors": [
  {
   "tag": "succession_instability",
   "layer": "dynastic_legitimacy",
   "description": "Saladin's practice of dividing territories among relatives created endemic fragmentation; Ayyubid princes frequently allied with Crusaders against each other, destroying the dynasty's anti-Crusader unity",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "tag": "military_technological_advantage",
   "layer": "military_security",
   "description": "The Mamluks (slave-soldier elite created by the Ayyubids themselves) developed superior military cohesion; Egyptian Mamluks overthrew Sultan Turanshah immediately after defeating the Seventh Crusade at Mansura",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "layer": "governance_institutional",
   "tag": "ayyubid_dynastic_division",
   "direction": "decline",
   "description": "Saladin's practice of distributing provinces to family members created permanent Ayyubid sub-dynasties in Damascus, Aleppo, Homs, Hamah, and Yemen. These relatives cooperated occasionally but competed chronically, preventing unified military response to both Crusaders and Mongols.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q180114",
     "url": "https://www.wikidata.org/wiki/Q180114"
    },
    {
     "type": "wikipedia",
     "label": "Ayyubid Sultanate",
     "url": "https://en.wikipedia.org/wiki/Ayyubid_dynasty"
    }
   ]
  },
  {
   "layer": "military_security",
   "tag": "mamluk_military_coup",
   "direction": "decline",
   "description": "The Mamluk slave-soldiers, brought in for military strength, overthrew Sultan Turanshah (1250) just after defeating the Seventh Crusade. This military coup ended Ayyubid rule in Egypt and inaugurated the Mamluk sultanate, which rapidly absorbed remaining Ayyubid territories.",
   "sources": [
