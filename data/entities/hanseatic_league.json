 "lifecycle_phases": [
  {
   "phase": "early_formation",
   "years": "1159–1280",
   "description": "German merchants settle at Visby (Gotland) and establish the Kontore (trading posts) at London (Steelyard), Bruges, Bergen, and Novgorod. The Hanseatic diet first meets formally (1260s). The League protects merchant shipping through collective action against piracy and secures trading privileges from rulers by threatening embargoes.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "phase": "zenith",
   "years": "1280–1400",
   "description": "The Hanseatic League at its height controls Baltic and North Sea trade, with 200+ member cities. Lübeck, Hamburg, and Bremen are the core cities. The League defeats Denmark at the Battle of the Helgeå (1362) and imposes the Treaty of Stralsund (1370), giving the League effective control of Danish foreign policy. Herring fisheries at Scania, Baltic grain, Russian furs, Swedish iron, all flow through Hanseatic networks.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "phase": "decline",
   "years": "1400–1500",
   "description": "The League faces rising competition from Dutch shipping (the fluyt design makes Dutch transport cheaper), growing royal power in England and Scandinavia that challenges Hanseatic privileges, and internal conflicts between coastal and inland cities. The Baltic herring stocks shift from Scania to the Dutch-controlled North Sea. Member cities increasingly pursue independent policies, weakening collective action.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  }
 ],
 "rise_factors": [
  {
   "tag": "trade_route_control",
   "layer": "economic_commercial",
   "description": "The Hanseatic League controlled virtually all trade between the Baltic (grain, timber, furs, metals) and western Europe (cloth, wine, luxury goods); its network of Kontore and privileged access to English wool and Flemish cloth made it the essential middleman for northern European commerce",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "tag": "administrative_innovation",
   "layer": "governance_institutional",
   "description": "The League's collective merchant governance, with annual diets, shared enforcement of commercial law, and coordinated economic sanctions (embargoes), was a unique form of non-territorial political organization that predated the modern international organization concept",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "layer": "economic_commercial",
   "tag": "trade_route_control",
   "direction": "rise",
   "description": "The Hanse specialized in Baltic bulk commodities: Prussian grain, Swedish copper and iron, Norwegian fish, and Russian furs, goods too heavy for Italian galley trade. This commercial niche had no competition.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ],
   "tag_prose": "bulk_goods_trade_specialization"
  },
  {
   "layer": "governance_institutional",
   "tag": "kontor_extraterritorial_privileges",
   "direction": "rise",
   "description": "Hanseatic Kontore (trading posts) in London, Bruges, Bergen, and Novgorod enjoyed extraterritorial legal status, exemption from local taxes, and dedicated storage, competitive advantages protected by treaty rather than military conquest.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "layer": "military_security",
   "tag": "military_organizational_advantage",
   "direction": "rise",
   "description": "The Hanse's naval coalition defeated Denmark in 1370 (Treaty of Stralsund), extracting the right to ratify Danish royal succession, an extraordinary political concession from a sovereign state to a commercial confederation.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ],
   "tag_prose": "stralsund_treaty_military_victory"
  },
  {
   "layer": "governance_institutional",
   "tag": "kontor_system",
   "direction": "rise",
   "description": "The Hanseatic Kontors at London (Steelyard), Bruges, Bergen, and Novgorod gave member cities permanent commercial embassies with extraterritorial legal rights, transforming ad hoc trading relationships into a durable institutional network.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  }
 ],
 "decline_factors": [
  {
   "tag": "trade_route_disruption",
   "layer": "economic_commercial",
   "description": "Dutch shipping innovations (the fluyt cargo ship c.1595, bulk-cargo focus) undercut Hanseatic transport costs; Dutch direct trade with the Baltic bypassed the League's middleman position and the English Merchant Adventurers directly competed in cloth exports",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "tag": "internal_fragmentation",
   "layer": "governance_institutional",
   "description": "As member cities' interests diverged, coastal cities favoring open Baltic competition, inland cities protecting overland routes, collective action became impossible; cities increasingly made separate commercial agreements with rulers that undercut League solidarity",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ]
  },
  {
   "layer": "economic_commercial",
   "tag": "external_displacement",
   "direction": "decline",
   "description": "Dutch development of the fluyt (cheap bulk carrier) in the late 15th century undercut Hanseatic freight costs. Dutch traders systematically penetrated Baltic markets by offering lower transport costs and more flexible capital arrangements.",
   "sources": [
    {
     "type": "wikidata",
     "id": "Q42908",
     "url": "https://www.wikidata.org/wiki/Q42908"
    },
    {
     "type": "wikipedia",
     "label": "Hanseatic League",
     "url": "https://en.wikipedia.org/wiki/Hanseatic_League"
    }
   ],
   "tag_prose": "dutch_competition_displacement"
  },
  {
   "layer": "governance_institutional",
   "tag": "state_centralization_pressure",
   "direction": "decline",
   "description": "As territorial princes centralized power (Denmark, Poland, England, Russia), they revoked Hanseatic privileges. Ivan III's closure of the Novgorod Kontor (1494) severed the eastern anchor of the Hanse commercial network.",
   "sources": [
    {
