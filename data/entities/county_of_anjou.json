      ]
    },
    {
      "layer": "dynastic_legitimacy",
      "tag": "plantagenet_acquisition_england",
      "direction": "rise",
      "description": "Henry II's accession to the English throne (1154) transformed Anjou from a regional county into the senior partner in the Angevin Empire stretching from Scotland to the Pyrenees. Angevin resources, English royal revenues plus French territories, made Henry the most powerful western European ruler.",
      "sources": [
        {
