        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "external_alliance",
      "direction": "rise",
      "description": "Successive counts of Anjou pursued strategic marriages and military campaigns to absorb Maine (1110) and Normandy (1144), assembling the territorial bloc that gave their dynasty claim to the English throne.",
      "sources": [
        {
          "type": "wikidata",
