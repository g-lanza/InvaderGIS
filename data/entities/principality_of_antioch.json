  "lifecycle_phases": [
    {
      "phase": "establishment",
      "years": "1098–1130",
      "description": "Bohemond of Taranto besieges and captures Antioch during the First Crusade (1098), then claims it for himself rather than returning it to Byzantium. The Principality becomes the most northerly and strategically important Crusader state, controlling routes between Anatolia and the Levant.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "phase": "contested_survival",
      "years": "1130–1200",
      "description": "Constant pressure from Byzantine claims, Seljuk Sultanate of Rum, and Zengi's successors. Raymond of Poitiers killed by Nur ad-Din (1149). Byzantine Emperor Manuel I temporarily reinstates suzerainty (1158). Saladin reduces Antioch's territory after Hattin.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "phase": "final_decline",
      "years": "1200–1268",
      "description": "Gradually absorbed into the County of Tripoli under the Bohemond dynasty. Mamluk Sultan Baybars captures and sacks Antioch (1268), reportedly the largest city in the Crusader world, destroying it so thoroughly it never recovers.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_advantage",
      "layer": "geography_territory",
      "description": "Antioch's location on the Orontes River controlled the northern route between Anatolia and Syria; the city's massive ancient walls made it defensible and a natural base for Crusader operations across northern Syria",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "Norman military traditions (Bohemond was son of the Norman conqueror Robert Guiscard) gave the Principality exceptional military leadership and fortification techniques adapted to the Near East",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "resource_concentration",
      "direction": "rise",
      "description": "The Orontes valley around Antioch produced exceptional agricultural surpluses: olive oil, wine, and silkworm cultivation. These products supported a dense urban population and funded Norman ruling class patronage.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ],
      "tag_prose": "orontes_valley_agriculture"
    },
    {
      "layer": "governance_institutional",
      "tag": "armenian_christian_cooperation",
      "direction": "rise",
      "description": "The Armenian population of Cilicia and northern Syria cooperated extensively with Norman Antioch, providing local military forces, administrative expertise, and commercial connections that Latin newcomers lacked.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "roger_of_salerno_campaigns",
      "direction": "rise",
      "description": "Roger of Salerno's aggressive campaigns (r.1113–19) expanded Antioch's territorial base into the surrounding Muslim-controlled regions, demonstrating that a well-organized Norman polity could compete militarily with larger Muslim neighbors.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "Disputed successions involving Byzantine claims, female inheritance, and competing barons created chronic internal weakness; regencies after battlefield defeats left the principality without consistent leadership",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "tag": "rival_fragmentation",
      "layer": "external_political",
      "description": "Nur ad-Din and then Saladin's unification of Syria surrounded Antioch on all landward sides; Mamluk Baybars' systematic destruction of Crusader castles ultimately made the principality indefensible",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q235030",
          "url": "https://www.wikidata.org/wiki/Q235030"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Antioch",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Antioch"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "ager_sanguinis_disaster",
      "direction": "decline",
      "description": "The Field of Blood (1119) annihilated the Antiochene army and killed Roger of Salerno. This single battle destroyed Antioch's indigenous military capacity for a generation and required Byzantine and Crusader reinforcement to survive.",
      "sources": [
        {
