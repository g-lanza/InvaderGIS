  "lifecycle_phases": [
    {
      "phase": "carolingian_county",
      "years": "778–1112",
      "description": "Toulouse is granted as a county in the Carolingian system (778) to control the route between the Iberian Peninsula and the Frankish heartland. The counts of Toulouse accumulate enormous territories across southern France, becoming one of the most powerful French lords and rulers of a distinct 'Occitanian' culture with its troubadour poetry and tolerance for religious diversity.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    },
    {
      "phase": "cathar_crisis_and_albigensian_crusade",
      "years": "1112–1271",
      "description": "The Counts of Toulouse tolerate Catharism (a Christian heresy) among their subjects; this tolerance, combined with the county's de facto independence from French royal control, makes it a target. Pope Innocent III launches the Albigensian Crusade (1209) after the murder of his legate; Simon de Montfort's forces devastate Languedoc. The Inquisition is established (1233). The Treaty of Paris (1229) and then the count's death without male heirs (1271) transfers Toulouse to the French crown.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "Toulouse controlled the Garonne valley trade route connecting the Atlantic (Bordeaux) and the Mediterranean (Narbonne), making it the central nexus of trans-Pyrenean commerce; the counts' tolls on this route funded the brilliant Occitanian court culture",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    },
    {
      "tag": "occitan_culture",
      "layer": "ideology_religion",
      "description": "Toulouse was the cultural capital of Occitania; troubadour poetry, vernacular literacy, and relative religious tolerance (including Cathar coexistence) created an exceptionally vibrant cultural environment that attracted scholars, poets, and merchants",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    },
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "The Garonne River and major routes connecting Iberia to Italy passed through Toulouse; grain, wine, and textile tolls made the county wealthy relative to its size",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ],
      "tag_prose": "trade_revenues"
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "The Garonne corridor, Toulouse's geographic basis, was the main overland route between the Mediterranean and Atlantic Europe. Toulouse merchants and the counts who taxed them controlled the most important trade artery in southern France.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ],
      "tag_prose": "mediterranean_north_trade_route"
    },
    {
      "layer": "ideology_religion",
      "tag": "religious_legitimacy",
      "direction": "rise",
      "description": "The courts of Toulouse and Provence patronized troubadour poetry, vernacular Occitan lyric verse that influenced all subsequent European lyric traditions. This cultural sophistication reflected the county's prosperity and cosmopolitan connections.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ],
      "tag_prose": "troubadour_culture_patronage"
    },
    {
      "layer": "ideology_religion",
      "tag": "cathar_religious_tolerance",
      "direction": "rise",
      "description": "Raymond VI's tolerance of Cathar heresy in his territories attracted diverse populations and avoided the religious conflict costs that devastated neighboring areas. The county's religious diversity reflected genuine pluralism unusual in 13th-century France.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "external_military_pressure",
      "layer": "military_security",
      "description": "The Albigensian Crusade (1209–1229) brought the full military resources of the French crown and northern French crusaders against Toulouse; Simon de Montfort's systematic devastation of Languedoc permanently weakened the county's military and demographic capacity",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    },
    {
      "tag": "albigensian_crusade",
      "layer": "external_political",
      "description": "The Albigensian Crusade (1209-1229), launched to destroy Catharism, devastated Languedoc; the Treaty of Paris (1229) forced Count Raymond VII to dismantle fortifications and cede his daughter's inheritance to French royal succession, ending independent Toulousain power",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ]
    },
    {
      "tag": "external_military_pressure",
      "layer": "dynastic_legitimacy",
      "description": "Without a male heir, the county passed through Raymond VII's daughter Jeanne to her husband, Alphonse of Poitiers (brother of Louis IX); at Alphonse's death in 1271, Toulouse reverted to the French crown",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1334322",
          "url": "https://www.wikidata.org/wiki/Q1334322"
        },
        {
          "type": "wikipedia",
          "label": "County of Toulouse",
          "url": "https://en.wikipedia.org/wiki/County_of_Toulouse"
        }
      ],
      "tag_prose": "capetian_absorption"
    },
    {
      "layer": "military_security",
      "tag": "albigensian_crusade_devastation",
      "direction": "decline",
      "description": "The Albigensian Crusade (1209–29), launched against Cathar heresy but driven by French royal expansion, devastated the county. The Massacre at Béziers (1209), siege of Carcassonne, and 20 years of warfare destroyed the county's prosperity and forced territorial concessions.",
      "sources": [
        {
