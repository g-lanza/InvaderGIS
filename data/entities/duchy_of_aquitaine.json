  "rise_factors": [
    {
      "tag": "resource_concentration",
      "layer": "economic_commercial",
      "description": "Wine trade from the Bordeaux region, diverse agricultural surplus, and Atlantic salt production made Aquitaine one of the wealthiest French duchies.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q7703611",
