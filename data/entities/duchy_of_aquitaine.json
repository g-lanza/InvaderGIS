    {
      "layer": "ideology_religion",
      "tag": "troubadour_culture",
      "direction": "rise",
      "description": "Aquitaine under William IX and Eleanor was the origin of troubadour poetry, creating a cultural prestige that attracted scholars, artists, and clerics and legitimized ducal authority.",
