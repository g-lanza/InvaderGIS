    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Aquitaine's vineyards produced wine for the Anglo-Norman market, generating substantial revenues that funded ducal administration and military capacity throughout the 12th century.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q7703611",
          "url": "https://www.wikidata.org/wiki/Q7703611"
