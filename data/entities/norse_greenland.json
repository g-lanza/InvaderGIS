  "lifecycle_phases": [
    {
      "phase": "settlement",
      "years": "985–1200",
      "description": "Erik the Red, exiled from Iceland, establishes two Norse settlements on Greenland's southwest coast (985): the Eastern Settlement (Eystribyggð) near modern Narsarsuaq and the Western Settlement (Vestribyggð) near modern Nuuk. At peak, 3,000–5,000 Norse settlers raise cattle, hunt walrus, and export furs and ivory to Norway. The Eastern Settlement's church at Garðar has a cathedral; Greenland becomes a bishopric (1124).",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "phase": "decline_and_disappearance",
      "years": "1200–1450",
      "description": "The Little Ice Age (c.1300) makes Greenland progressively colder; sea ice blocks the shipping lanes. The Black Death (1349–1350) in Norway disrupts the supply ships that Greenland depended on. The Western Settlement is abandoned by c.1350. Inuit (Thule culture) migration southward brings a technologically superior cold-weather culture into contact with the Norse. The Eastern Settlement disappears; the last dated written record from Norse Greenland is 1408.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "resource_concentration",
      "layer": "economic_commercial",
      "description": "Greenlandic walrus ivory was the finest ivory available in medieval Europe, elephant ivory being rare and expensive; Greenlandic hunting parties in the High Arctic brought back walrus tusks, polar bear skins, and white falcons that commanded premium prices in European markets",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "tag": "erik_the_red_colonization",
      "layer": "military_security",
      "description": "Erik the Red's deliberate colonization of Greenland (c. 985) established two settlement clusters, the Eastern and Western Settlements, organized around pastoral farming; the settlements' survival for over four centuries in marginal conditions demonstrates the Norse capacity for adaptive colonization",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "tag": "trade_route_control",
      "layer": "economic_commercial",
      "description": "Greenlandic walrus ivory was among the most prized luxury materials in medieval Europe; it funded church construction (the cathedral at Gardar), episcopal appointments, and royal Norwegian tribute through a trade that connected the Arctic to the Mediterranean market",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ],
      "tag_prose": "walrus_ivory_trade"
    },
    {
      "tag": "church_institutional_presence",
      "layer": "ideology_religion",
      "description": "Greenland received its own bishop (Diocese of Gardar, established c. 1124) and eventually had 12 parish churches; church buildings of dressed stone represented an extraordinary capital investment for the small population and anchored Norse identity and organization",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Norse Greenland supplied Europe with walrus ivory, narwhal tusks, polar bear skins, and live falcons, luxury goods commanding extraordinary prices that made even a small community commercially viable.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ],
      "tag_prose": "arctic_trade_goods"
    }
  ],
  "decline_factors": [
    {
      "tag": "climate_shock",
      "layer": "population_environment",
      "description": "The Medieval Warm Period (c.900–1300) that made Greenland settlement viable gave way to the Little Ice Age; advancing sea ice blocked shipping lanes and the growing season shortened, making Norse cattle farming marginal while the Inuit's seal-hunting culture proved more adaptable",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "tag": "trade_route_disruption",
      "layer": "economic_commercial",
      "description": "African elephant ivory flowing through Italian merchant networks gradually replaced Greenlandic walrus ivory in European markets; the Black Death's disruption of Norwegian shipping networks severed Greenland's commercial lifeline at the worst possible moment",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "tag": "climate_shock",
      "layer": "economic_commercial",
      "description": "Cooling temperatures from the 13th century reduced the growing season and increased sea ice; the Norse farming system, adapted to Scandinavian conditions, could not adjust quickly enough, and reduced haymaking meant the cattle herds could not survive increasingly harsh winters",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ],
      "tag_prose": "little_ice_age_onset"
    },
    {
      "tag": "ivory_market_collapse",
      "layer": "economic_commercial",
      "description": "The reopening of African elephant ivory trade in the 13th century collapsed the price of walrus ivory; Greenland's sole export commodity was devalued just as the colony needed resources to cope with climate deterioration, removing the economic rationale for maintaining the settlement",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
          "label": "Norse Greenland",
          "url": "https://en.wikipedia.org/wiki/Greenlandic_Norse"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "elephant_ivory_competition",
      "direction": "decline",
      "description": "The reopening of African elephant ivory trade routes in the 14th century crashed walrus ivory prices, eliminating Greenland's primary commercial advantage precisely as the climate cooled and sailing conditions worsened.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q855236",
          "url": "https://www.wikidata.org/wiki/Q855236"
        },
        {
          "type": "wikipedia",
