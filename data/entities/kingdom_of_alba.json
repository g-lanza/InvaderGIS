  "lifecycle_phases": [
    {
      "phase": "pictish_scottish_union",
      "years": "843–1040",
      "description": "Kenneth MacAlpin's union of the Picts and Scots (843) creates Alba, the kingdom of the Scots centered on Perthshire and Angus. The kingdom speaks both Gaelic (among the Scots) and Pictish; Pictish culture and language gradually fade under Gaelic dominance. Vikings from Orkney and Hebrides continuously raid the coasts. Constantine II (900–943) provides stability through decades of diplomacy and defensive warfare.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "phase": "expansion",
      "years": "1040–1286",
      "description": "Malcolm II's victory at Carham (1018) adds Lothian, giving Alba Edinburgh and the Forth. His grandson Duncan I is murdered by Macbeth (1040); Macbeth rules well for 17 years before being killed by Malcolm III Canmore (1057). Under David I (1124–1153) Alba transforms into a feudal kingdom along Anglo-Norman lines while retaining Celtic traditions. 'Alba' gradually becomes 'Scotland'; the kingdom's identity is consolidated.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "dynastic_consolidation",
      "layer": "dynastic_legitimacy",
      "description": "The MacAlpin dynasty's mythologized unification of Picts and Scots provided the legitimating narrative for a kingdom whose ethnic diversity (Scots, Picts, Britons, Angles, Vikings) could otherwise have fragmented; the dynasty's survival through multiple assassination attempts shows its political resilience",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "tag": "gaelic_pictish_fusion",
      "layer": "ideology_religion",
      "description": "The merger of Gaelic Dál Riata and the Pictish kingdom created a culturally cohesive highland state; the Columban church provided spiritual authority and educational infrastructure that unified disparate tribal groupings",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "dynastic_consolidation",
      "direction": "rise",
      "description": "Kenneth MacAlpin's consolidation of Pictish and Dalriadic kingdoms (c.843) created a unified Scotia under a single dynasty. The merger of two distinct cultures into a coherent political entity was the essential precondition for Scottish statehood.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ],
      "tag_prose": "pictish_dalriada_unification"
    },
    {
      "layer": "military_security",
      "tag": "viking_threat_consolidation",
      "direction": "rise",
      "description": "Persistent Norse raids on monastic settlements and coastal areas forced Scottish kingdoms to consolidate or perish. The shared threat created political incentives for unification that internal competition alone had not provided.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "mormaer_governance_system",
      "direction": "rise",
      "description": "The mormaer (great steward) system of regional governance distributed royal authority through powerful regional lords who commanded local levies, enabling Alba to administer a large territory without Roman-style bureaucracy.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "layer": "ideology_religion",
      "tag": "columban_church_network",
      "direction": "rise",
      "description": "The Columban monastic tradition (Iona, Dunkeld) provided literacy, historical consciousness, and administrative expertise to the kingdom. Abbots served as royal advisors and their monasteries as secure storage for royal treasures and records.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "Celtic tanistry, rotating succession among eligible males of the royal line, produced endemic violence; multiple Scottish kings died by assassination or in battle against rivals, with Macbeth's killing of Duncan I being the most famous example",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "tag": "viking_pressure",
      "layer": "external_political",
      "description": "Norse settlement of the Hebrides and Orkney persistently pressured Alba's western and northern flanks; the Norse maintained control of the Western Isles until 1266, fragmenting potential Scottish maritime power",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "english_overlordship_pressure",
      "direction": "decline",
      "description": "English kings periodically demanded Scottish kings perform homage for Scottish lands held in England, blurring the boundary between personal feudal obligation and national subjugation, a persistent source of conflict and constitutional ambiguity.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "english_intervention",
      "direction": "decline",
      "description": "English kings repeatedly intervened in Scottish succession disputes in the late 13th century; Edward I's claim to feudal overlordship and his conquest of 1296 transformed Alba's gradual evolution into a crisis that only the Wars of Scottish Independence resolved.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1991742",
          "url": "https://www.wikidata.org/wiki/Q1991742"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Alba",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Alba"
        }
      ]
    }
  ],
