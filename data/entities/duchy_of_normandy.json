          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "Normans combined Viking seamanship and raiding capability with Frankish heavy cavalry and castle-building; their military system, heavy cavalry, motte-and-bailey castles, combined arms, was the most effective in Europe by the mid-11th century",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "tag": "dynastic_consolidation",
      "layer": "dynastic_legitimacy",
      "description": "The Rollonid dynasty (descendants of Rollo) maintained surprisingly stable succession for five generations, allowing ducal authority to accumulate; William's suppression of the Norman baronial revolts (1046–1054) centralized control more effectively than any comparable French duchy",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "mobility_advantage",
      "direction": "rise",
      "description": "Norman warfare combined Viking naval mobility with mounted cavalry, a unique hybrid enabling rapid strategic deployment. This combination proved decisive in England (1066), Sicily (1061–91), and the First Crusade.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ],
      "tag_prose": "viking_maritime_expertise"
    },
    {
      "layer": "governance_institutional",
      "tag": "church_alliance_legitimacy",
      "direction": "rise",
      "description": "Norman dukes cultivated close ties with the Cluniac reform movement, endowing monasteries (Bec, Mont-Saint-Michel) that provided both administrative talent and papal endorsement for Norman expansionism.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "trade_route_control",
      "direction": "rise",
      "description": "Control of the Seine estuary gave Normandy commercial access to both English Channel and Paris basin trade. Rouen became a major commercial hub, and Norman lords accumulated merchant-fleet revenues supplementing agricultural income.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ],
      "tag_prose": "channel_trade_position"
    },
    {
      "layer": "military_security",
      "tag": "conquest_of_england",
      "direction": "rise",
      "description": "The conquest of England (1066) transformed Normandy from a regional duchy to the senior partner in an Anglo-Norman realm. The combined resources of England and Normandy elevated Norman military capacity dramatically.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "military_organizational_advantage",
      "direction": "rise",
      "description": "William the Conqueror's victory at Hastings (1066) made the Duke of Normandy simultaneously King of England, creating a cross-Channel dominion that enriched the duchy with English revenues and established Norman French as the language of English governance for 300 years.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ],
      "tag_prose": "battle_of_hastings"
    }
  ],
  "decline_factors": [
    {
      "tag": "overextension",
      "layer": "governance_institutional",
      "description": "Ruling England and Normandy simultaneously required constant cross-Channel campaigning; the Angevin empire's vast continental territories made coherent defense impossible, allowing Philip II of France to exploit every baronial revolt and royal minority",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "William Rufus's death (1100) and the resulting civil war between his brothers, then the Anarchy (1135–1153) between Stephen and Matilda, repeatedly disrupted Norman governance; contested successions gave French kings opportunities to detach Norman barons from English loyalty",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "external_military_pressure",
      "direction": "decline",
      "description": "Philip II Augustus of France conquered Normandy (1204) when King John of England failed to defend it. The Capetian absorption ended the duchy's autonomous status and integrated its revenues directly into the French royal domain.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
