  "lifecycle_phases": [
    {
      "phase": "viking_settlement",
      "years": "911–996",
      "description": "Charles the Simple grants the Seine estuary to Rollo (Hrólf), a Viking chieftain, in the Treaty of Saint-Clair-sur-Epte (911) in exchange for protecting France from further raids. Rollo's descendants ('Normans', i.e. Northmen) rapidly absorb Frankish culture, convert to Christianity, and marry into Carolingian nobility. By Richard I's death (996) they speak French rather than Norse.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "phase": "consolidation_and_expansion",
      "years": "996–1066",
      "description": "Duke Richard II (996–1026) stabilizes the duchy's borders and builds a powerful administrative system. Robert I and his illegitimate son William (the future Conqueror) face major revolts from Norman barons. William consolidates control after the Battle of Val-ès-Dunes (1047), then claims England's throne. His victory at Hastings (1066) joins Normandy and England into a cross-Channel polity.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q842091",
          "url": "https://www.wikidata.org/wiki/Q842091"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Normandy",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Normandy"
        }
      ]
    },
    {
      "phase": "union_with_england",
      "years": "1066–1204",
      "description": "Under William the Conqueror and his sons, Normandy and England form an Anglo-Norman realm. Norman knights spread across Europe, to Sicily, Antioch, and the Crusader states. King John loses Normandy to Philip II of France at the conclusion of the 1202–1204 campaign, ending Normandy's status as an English possession, though the Channel Islands remain under the English crown.",
      "sources": [
        {
          "type": "wikidata",
