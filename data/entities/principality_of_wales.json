  "rise_factors": [
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "Snowdonia's mountain terrain allowed Welsh guerrilla forces to resist English cavalry-based armies for decades; castles at Harlech, Caernarfon, and Conway were required to hold Wales permanently, an enormous investment demonstrating how costly conquest was",
      "sources": [
        {
