  "lifecycle_phases": [
    {
      "phase": "welsh_resistance",
      "years": "1216–1267",
      "description": "Llywelyn ab Iorwerth 'the Great' (1216–1240) unifies most Welsh princes under his authority, becoming the dominant Welsh ruler. He negotiates the Treaty of Worcester (1218) with Henry III, securing recognition of Welsh autonomy. The Treaty of Montgomery (1267) recognizes Llywelyn ap Gruffudd as 'Prince of Wales', the first time an English king acknowledges a single Welsh prince.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1483510",
          "url": "https://www.wikidata.org/wiki/Q1483510"
        },
        {
          "type": "wikipedia",
          "label": "Principality of Wales",
          "url": "https://en.wikipedia.org/wiki/Principality_of_Wales"
        }
      ]
    },
    {
      "phase": "conquest",
      "years": "1267–1283",
      "description": "Llywelyn ap Gruffudd refuses to pay homage to Edward I; Edward invades (1276–1277) and forces submission. Llywelyn's brother Dafydd begins a second rebellion (1282); Llywelyn is killed in a skirmish (December 1282) and Dafydd is captured and executed (1283). Edward I's Statute of Rhuddlan (1284) incorporates Wales into the English crown. Edward presents his infant son as the first English Prince of Wales (1301).",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1483510",
          "url": "https://www.wikidata.org/wiki/Q1483510"
        },
        {
