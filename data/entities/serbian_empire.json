  "lifecycle_phases": [
    {
      "phase": "foundation",
      "years": "1346–1355",
      "description": "Stefan Dušan, having expanded Serbian territory to encompass Albania, Epirus, Thessaly, and Macedonia, crowns himself 'Emperor of the Serbs and Greeks' at Skopje (1346). He issues the Dušan's Code (1349, revised 1354), the most comprehensive medieval Serbian law code. His empire reaches from the Adriatic to the Aegean, making Serbia the dominant Balkan power and nearly encircling the rump Byzantine state.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "phase": "immediate_collapse",
      "years": "1355–1371",
      "description": "Stefan Dušan's death (1355) triggers immediate fragmentation; his son Stefan Uroš V is nominal emperor but real power lies with regional lords (Mrnjavčević brothers, Balšić, Lazarević, Branković families). The Battle of Maritsa (1371), where Ottoman forces under Lala Şahin Pasha annihilate a Serbian army including the brothers Vukašin and Uglješa, effectively ends the empire and makes surviving Serbian lords Ottoman vassals.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "Stefan Dušan combined Serbian heavy cavalry with Western mercenaries (Catalans, Byzantines) and a sophisticated siege capability; his campaigns across Albania, Thessaly, and Macedonia showed systematic strategic planning across multiple theaters simultaneously",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "tag": "rival_fragmentation",
      "layer": "external_political",
      "description": "Byzantine civil wars between Andronikos III and John V Palaiologos (1341–1347) provided the opportunity for Serbian expansion; Dušan exploited Byzantine weakness to occupy Epirus, Thessaly, and Macedonia with minimal resistance",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "layer": "military_security",
      "tag": "stefan_dusan_campaigns",
      "direction": "rise",
      "description": "Stefan Dušan (r.1331–55) conquered Macedonia, Epirus, Thessaly, and Albania, quadrupling Serbian territory in a decade. His campaigns exploited Byzantine civil wars and demonstrated that a unified Balkan power could challenge the reduced Byzantine state.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "legal_codification",
      "direction": "rise",
      "description": "The Dušanov Zakonik (1349), one of the most comprehensive medieval law codes, regulated property, church relations, and social obligations across the multi-ethnic empire. Its comprehensive scope indicated high administrative ambition.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ],
      "tag_prose": "dusan_law_code"
    },
    {
      "layer": "ideology_religion",
      "tag": "orthodox_patriarchate_elevation",
      "direction": "rise",
      "description": "Stefan Dušan elevated the Serbian Archbishop to Patriarch (1346), creating an autocephalous Serbian Orthodox Church independent of Constantinople. This symbolic act reinforced imperial status and provided ecclesiastical legitimacy for territorial conquest.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "layer": "economic_commercial",
      "tag": "resource_concentration",
      "direction": "rise",
      "description": "Serbian silver mines at Novo Brdo, Srebrenica, and Rudnik were the most productive in the Balkans; Stefan Dušan's conquests added control over Macedonian gold-bearing rivers, generating revenues sufficient to challenge both Byzantium and Hungary.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ],
      "tag_prose": "mining_and_silver"
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "Dušan's empire collapsed within 16 years of his death; his son lacked both personality and support, and the empire's rapid expansion had created powerful regional lords who felt no loyalty to the central state",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "tag": "external_military_pressure",
      "layer": "military_security",
      "description": "Ottoman military expansion into the Balkans after the crossing at Gallipoli (1354) confronted the fragmented Serbian successor states one by one; the Battle of Maritsa (1371) and Battle of Kosovo (1389) ended Serbian independence",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    },
    {
      "layer": "dynastic_legitimacy",
      "tag": "internal_fragmentation",
      "direction": "decline",
      "description": "After Dušan's sudden death (1355), the empire immediately fragmented: regional nobles (župans) declared independence, and his son Stefan Uroš V could not reassert central authority. The empire lasted only 16 years after its greatest extent.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ],
      "tag_prose": "succession_fragmentation_after_dusan"
    },
    {
      "layer": "military_security",
      "tag": "kosovo_field_collapse",
      "direction": "decline",
      "description": "The Battle of Kosovo (1389), fought by a Serbian-led coalition including Bulgarians and Bosnians, failed to stop Ottoman expansion. Despite killing Sultan Murad I, the Christian coalition was defeated and the Balkans entered Ottoman tributary status.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q1406298",
          "url": "https://www.wikidata.org/wiki/Q1406298"
        },
        {
          "type": "wikipedia",
          "label": "Serbian Empire",
          "url": "https://en.wikipedia.org/wiki/Serbian_Empire"
        }
      ]
    }
  ],
