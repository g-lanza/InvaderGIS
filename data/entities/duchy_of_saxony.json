  "lifecycle_phases": [
    {
      "phase": "ottonian_foundation",
      "years": "804–962",
      "description": "Saxony is incorporated into the Carolingian Empire after Charlemagne's brutal conquest of the Saxons (772–804), forced conversion, and the transplanting of thousands of Saxons. The Saxon duchy emerges under the Liudolfing dynasty. Henry the Fowler (912–936) defeats the Magyars and establishes East Frankish hegemony. His son Otto I defeats the Magyars at Lechfeld (955) and is crowned Holy Roman Emperor (962).",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
          "url": "https://www.wikidata.org/wiki/Q164092"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Saxony",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Saxony"
        }
      ]
    },
    {
      "phase": "high_medieval",
      "years": "962–1180",
      "description": "The Saxon duchy is the core of the Ottonian and Salian dynasties' power. Henry the Lion (Welf, 1142–1180) controls both Saxony and Bavaria, making him nearly as powerful as the emperor. His refusal to support Frederick Barbarossa in Italy leads to his downfall: he is tried, convicted, and exiled (1180); Saxony is dismembered and never reconstituted as a unified duchy.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
          "url": "https://www.wikidata.org/wiki/Q164092"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Saxony",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Saxony"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "Saxon heavy cavalry, developed under Henry the Fowler's military reforms, was the most effective force in 10th-century Europe; the defeat of the Magyars at Lechfeld (955) established Saxon military superiority and made Otto I the dominant ruler of Europe",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
          "url": "https://www.wikidata.org/wiki/Q164092"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Saxony",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Saxony"
        }
      ]
    },
    {
      "tag": "resource_concentration",
      "layer": "economic_commercial",
      "description": "The Harz mountains' silver mines (discovered c.968) provided the Ottonian dynasty with an independent silver supply that funded the imperial military and administration without dependence on feudal tribute",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
          "url": "https://www.wikidata.org/wiki/Q164092"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Saxony",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Saxony"
        }
      ]
    },
    {
      "tag": "ottonian_dynasty_origin",
      "layer": "military_security",
      "description": "The dukes of Saxony became the Ottonian dynasty; Henry the Fowler and Otto I transformed Saxony from a regional duchy into the core of the Holy Roman Empire, bringing imperial resources back to enrich the ducal homeland",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
          "url": "https://www.wikidata.org/wiki/Q164092"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Saxony",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Saxony"
        }
      ]
    },
    {
      "tag": "eastern_frontier_expansion",
      "layer": "military_security",
      "description": "Saxon military expansion eastward into Slavic territories, the Northern and Eastern Marches, created new tributary lands and the foundation of later German territorial states in Brandenburg and Meissen",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
          "url": "https://www.wikidata.org/wiki/Q164092"
        },
        {
          "type": "wikipedia",
          "label": "Duchy of Saxony",
          "url": "https://en.wikipedia.org/wiki/Duchy_of_Saxony"
        }
      ]
    },
    {
      "tag": "resource_concentration",
      "layer": "economic_commercial",
      "description": "The Harz Mountain silver mines, developed intensively from the 10th century, made Saxony the wealthiest duchy in Germany; the Goslar palatial complex sat atop this silver wealth and was the preferred seat of the Ottonian and Salian emperors",
      "sources": [
        {
          "type": "wikidata",
