        }
      ]
    },
    {
      "tag": "henry_the_lion_fall_1180",
      "layer": "military_security",
      "description": "Frederick Barbarossa's condemnation of Henry the Lion in 1180 broke up the great Saxon duchy; it was divided into Westphalia and a diminished \"Saxony\" for the Ascanian duke, permanently ending Saxon primacy in Germany",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
