        }
      ]
    },
    {
      "tag": "welf_hohenstaufen_feud",
      "layer": "military_security",
      "description": "The Welf-Hohenstaufen dynastic conflict drew Saxony into generations of imperial civil war; every Saxon duke had to choose sides, and the losing side invariably had ducal lands redistributed to enemies",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q164092",
