        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "internal_fragmentation",
      "direction": "decline",
      "description": "When Henry the Lion was deposed in 1180, Saxony was dismembered among the Archbishop of Cologne, the Bishop of Hildesheim, and the Duchy of Brunswick-Lüneburg, ending Saxon territorial unity.",
