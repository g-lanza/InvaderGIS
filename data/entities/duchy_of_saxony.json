  "decline_factors": [
    {
      "tag": "aristocratic_revolt",
      "layer": "governance_institutional",
      "description": "Henry the Lion's refusal to support Frederick Barbarossa in Italy (1176) allowed the emperor to convene a tribunal that convicted him of breach of feudal duty; the subsequent dismemberment of Saxony ended it as a unified duchy",
      "sources": [
        {
          "type": "wikidata",
