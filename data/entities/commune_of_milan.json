  "lifecycle_phases": [
    {
      "phase": "communal_government",
      "years": "1097–1277",
      "description": "Milan declares itself a commune (1097), one of the first Italian cities to achieve self-governance against the authority of the Archbishop and Holy Roman Emperor. It leads the Lombard League against Frederick Barbarossa, whose destruction of Milan (1162) galvanizes Italian city resistance; the League defeats him at Legnano (1176), the first great victory of infantry over feudal cavalry. Milan becomes the most populous city in medieval Europe north of Rome.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    },
    {
      "phase": "visconti_emergence",
      "years": "1277–1395",
      "description": "The Visconti family defeats the Della Torre family (1277) and establishes hereditary signorial rule while maintaining communal forms. Gian Galeazzo Visconti (1378–1402) consolidates the signoria, purchases the title of Duke of Milan (1395) from Emperor Wenceslaus IV, and nearly creates a unified northern Italian state before dying of plague. The commune is effectively over; the Duchy of Milan succeeds it.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "resource_concentration",
      "layer": "economic_commercial",
      "description": "Milan's position at the foot of the Alpine passes made it the distribution hub for trans-Alpine trade; Milanese wool, silk, and armor industries supplied markets from England to the Ottoman Empire, funding the civic programs and military ambitions of the commune",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    },
    {
      "tag": "military_organizational_advantage",
      "layer": "military_security",
      "description": "The Lombard League's innovation at Legnano (1176), using the carroccio (sacred war wagon) as a rallying point for infantry in a mixed formation against feudal cavalry, demonstrated that disciplined communal infantry could defeat armored knights",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    },
    {
      "tag": "lombard_league_leadership",
      "layer": "military_security",
      "description": "Milan led the Lombard League against Frederick Barbarossa, demonstrating its capacity to mobilize north Italian cities in coalition; defeating the emperor at Legnano (1176) established Milan as the preeminent communal power in Lombardy",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    },
    {
      "tag": "resource_concentration",
      "layer": "economic_commercial",
      "description": "Milan's control of the upper Po plain gave it access to the most productive agricultural land in Italy; surplus grain funded the Visconti and Sforza courts and supported a dense urban artisan population",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ],
      "tag_prose": "po_valley_agriculture"
    },
    {
      "tag": "military_organizational_advantage",
      "layer": "economic_commercial",
      "description": "Milanese armor and weapons workshops supplied armies across Europe by the 14th century; the city's metallurgical expertise, fed by Alpine iron, created an export industry that funded political ambitions and attracted skilled workers",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ],
      "tag_prose": "arms_manufacturing"
    },
    {
      "layer": "governance_institutional",
      "tag": "communal_autonomy",
      "direction": "rise",
      "description": "Milan's commune wrested self-governance from the Archbishop through the Credenza di Sant'Ambrogio in 1198, establishing elected consuls who managed taxation, justice, and military conscription independent of imperial or episcopal authority.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "internal_fragmentation",
      "layer": "governance_institutional",
      "description": "Factional conflict between the Guelph Della Torre and Ghibelline Visconti families consumed Milanese politics for decades; the commune's republican institutions could not resolve these conflicts, enabling the Visconti to establish permanent signorial power",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    },
    {
      "tag": "internal_fragmentation",
      "layer": "military_security",
      "description": "The struggle between the Torriani and Visconti families in the late 13th century exemplified the vulnerability of communal institutions to aristocratic capture; the commune's elected consuls could not resist signorie who combined wealth and military force",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ],
      "tag_prose": "factional_violence"
    },
    {
      "tag": "imperial_intervention_cycles",
      "layer": "military_security",
      "description": "Every imperial expedition (Henry VII 1310, Louis IV 1327) disrupted Milanese political stability; the city oscillated between Guelph and Ghibelline alignments depending on which external power threatened most, preventing the emergence of stable institutions",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q490",
          "url": "https://www.wikidata.org/wiki/Q490"
        },
        {
          "type": "wikipedia",
          "label": "Commune of Milan",
          "url": "https://en.wikipedia.org/wiki/Milan"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "signoria_transition",
      "direction": "decline",
      "description": "Recurrent factional violence between the Guelph Della Torre and Ghibelline Visconti families destabilized communal governance; the Visconti signoria established in 1277 ended the commune's republican institutions and concentrated power in a single dynasty.",
      "sources": [
        {
