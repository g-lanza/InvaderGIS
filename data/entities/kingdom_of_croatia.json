  "lifecycle_phases": [
    {
      "phase": "emergence",
      "years": "925–1091",
      "description": "Tomislav (925) is recognized as the first King of Croatia by the papacy, unifying the Pannonian and Dalmatian Croatian states. Croatia reaches its greatest extent under Petar Krešimir IV (1058–1074) who controls most of the Dalmatian coast. His successor Dmitar Zvonimir (1076–1089) receives his crown from the papacy and aligns Croatia with the Gregorian Reform movement. His death without heirs in disputed circumstances ends the Trpimirović dynasty.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "phase": "personal_union_with_hungary",
      "years": "1091–1102",
      "description": "Hungarian King Ladislaus I occupies Croatia (1091) following a disputed succession; the Pacta Conventa (1102), though its historical authenticity is disputed, is said to formalize a personal union between Croatia and Hungary. Croatia retains its Sabor (parliament), Ban (governor), and laws while sharing a king with Hungary. This union persists until 1918.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_advantage",
      "layer": "geography_territory",
      "description": "Croatia's Dalmatian coast provided access to Mediterranean trade and the economic and cultural wealth of the Italian city-states; the Dinaric Alps provided natural defense on the landward side",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "tag": "religious_legitimacy",
      "layer": "ideology_religion",
      "description": "Croatia's early conversion to Latin Christianity and alignment with the papacy gave it recognition as a legitimate Christian kingdom; Zvonimir's papal crown (1076) placed Croatia firmly in the Roman orbit against Byzantine and Orthodox influence",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "tag": "dalmatian_coast_control",
      "layer": "economic_commercial",
      "description": "Croatian rulers controlling the Dalmatian coast gained customs revenue from Adriatic trade and could interfere with Venetian and Byzantine commerce; coastal fortresses gave Croatian kings leverage in negotiations with maritime powers far beyond their inland military capacity",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "tag": "church_alliance_rome",
      "layer": "ideology_religion",
      "description": "Croatian kings received a royal crown from Pope Alexander II (or possibly Gregory VII) in the late 11th century; Roman recognition gave Croatian royalty a legitimacy independent of Byzantine or Hungarian claims, supporting the kingdom's autonomous identity",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "tag": "zwonimir_military_consolidation",
      "layer": "military_security",
      "description": "Dmitar Zvonimir (r. 1075–1089) consolidated the Croatian realm and received a royal crown from the pope; his reign represented the high point of independent Croatia, with the Dalmatian coasts, Slavonia, and Bosnia under unified Croatian rule",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "tomislav_royal_title",
      "direction": "rise",
      "description": "Tomislav of Croatia received recognition as king from Pope John X around 925, unifying Croatian Pannonia and Dalmatia under a single crown and creating the first independent Croatian state with Roman papal backing.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "The end of the Trpimirović dynasty without a clear male heir (1091) allowed Hungarian intervention; the disputed succession provided Ladislaus I of Hungary with the legal pretext to claim Croatia",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "tag": "hungarian_succession_union_1102",
      "layer": "military_security",
      "description": "The extinction of the Croatian Trpimirović dynasty led to the Pacta Conventa (1102), by which Croatian nobles accepted Coloman of Hungary as king; though Croatia retained its institutions, Hungarian political priorities dominated, and Croatian nobles became a subordinate class within the larger Kingdom",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "tag": "venetian_dalmatian_pressure",
      "layer": "military_security",
      "description": "Venice systematically purchased, pressured, or captured Dalmatian cities; by 1420 Venice controlled most of the Dalmatian coast, cutting Croatia off from maritime trade and the Mediterranean economy that had enriched earlier Croatian rulers",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "hungarian_personal_union",
      "direction": "decline",
      "description": "The Pacta Conventa agreement (1102) united Croatia with Hungary in a personal union under King Coloman, preserving Croatian noble privileges but ending full independence and orienting Croatia toward Central European politics.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q858841",
          "url": "https://www.wikidata.org/wiki/Q858841"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Croatia",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Croatia_(925%E2%80%931102)"
        }
      ]
    }
  ],
