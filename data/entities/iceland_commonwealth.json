  "decline_factors": [
    {
      "tag": "internal_fragmentation",
      "layer": "governance_institutional",
      "description": "The Commonwealth's lack of executive power meant no mechanism existed to enforce the law against the most powerful chieftains; when the Sturlungs accumulated enough power to ignore the Althing's rulings, the system had no recourse, only submission or civil war",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
