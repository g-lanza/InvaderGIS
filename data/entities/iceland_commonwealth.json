  "lifecycle_phases": [
    {
      "phase": "settlement_and_foundation",
      "years": "870–930",
      "description": "Norwegian settlers, many fleeing Harald Fairhair's unification of Norway, colonize Iceland (870s–930). The island is uninhabited except for a handful of Irish monks. The settlers bring Norse culture, language, and law. By 930, the Althing (general assembly) is established at Þingvellir, the world's oldest continuously functioning parliament, as the governing institution of the free farmers.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    },
    {
      "phase": "golden_age",
      "years": "930–1200",
      "description": "The Icelandic Commonwealth functions as a unique stateless republic: law is maintained by the Althing and 39 local Things (assemblies) with no executive power. The Sagas, the most sophisticated vernacular literature in medieval Europe, are composed in this period. Leif Eriksson reaches North America (Vinland, c.1000). Greenland is settled (985). The Christian conversion (999/1000) is decided by the Althing as a pragmatic compromise.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    },
    {
      "phase": "sturlungaöld_and_annexation",
      "years": "1200–1262",
      "description": "The 'Sturlung Age' (1220–1264) is a period of violent civil war among Iceland's leading chieftain families, particularly the Sturlungs. The violence and disorder, nearly 3,000 deaths in a population of 70,000, convinces many Icelanders that the Commonwealth cannot maintain order. Iceland accepts Norwegian sovereignty (1262–1264) in exchange for peace and regular grain shipments, ending the 330-year Commonwealth.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "administrative_innovation",
      "layer": "governance_institutional",
      "description": "The Althing was the most innovative governance experiment of the early medieval period: an annual assembly of all free farmers resolving disputes, passing laws, and managing the commons without a king or permanent executive; the system worked for 330 years",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    },
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "Iceland's island isolation protected the Commonwealth from external conquest for its entire existence; no medieval power had the naval capacity to project sustained military force across the North Atlantic",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    },
    {
      "tag": "althing_political_innovation",
      "layer": "military_security",
      "description": "The Althing, founded c. 930, was an annual assembly of all free farmers that settled legal disputes through the Lawspeaker's recitation of the law; this consensual system created political stability without a king, allowing Iceland to function as a republic for three centuries",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    },
    {
      "tag": "saga_literary_culture",
      "layer": "ideology_religion",
      "description": "Iceland's unique saga tradition, preserved and written after Christianization, created an unmatched record of Norse history and law; the literary culture invested legal and political memory in written texts that reinforced the Commonwealth's institutional memory",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q62389",
          "url": "https://www.wikidata.org/wiki/Q62389"
        },
        {
          "type": "wikipedia",
          "label": "Icelandic Commonwealth",
          "url": "https://en.wikipedia.org/wiki/Icelandic_Commonwealth"
        }
      ]
    },
    {
      "tag": "cod_fishery_walrus_ivory",
      "layer": "economic_commercial",
      "description": "Iceland's abundant cod fisheries and walrus ivory from Greenland voyages created export commodities that connected Icelandic chieftains to Norwegian and English trade networks; the resulting wealth sustained the chieftain class that operated the Althing",
