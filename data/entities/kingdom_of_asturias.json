  "lifecycle_phases": [
    {
      "phase": "foundation",
      "years": "718–791",
      "description": "Pelayo, a Visigothic nobleman, defeats an Umayyad raiding force at the Battle of Covadonga (718/722) in the Cantabrian mountains, traditionally the symbolic start of the Reconquista. The kingdom of Asturias emerges in the mountainous northwest as a refuge for Visigoths, Basques, and Christian refugees. The Asturian kings claim to be legitimate successors of the Visigothic Kingdom.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "phase": "expansion",
      "years": "791–910",
      "description": "Alfonso II 'the Chaste' (791–842) moves the capital to Oviedo and begins the ideological program of Asturian kingship as Visigothic restoration. Alfonso III 'the Great' (866–910) significantly expands southward, repopulating the Duero valley and pushing the frontier to the Duero river. The discovery of Santiago de Compostela's shrine (813) gives the kingdom an ideological anchor for Christian resistance.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "The Cantabrian mountains provided an impenetrable natural fortress; Umayyad cavalry tactics were useless in the mountain terrain where Pelayo's forces sheltered, allowing the kingdom to survive until it could build military capacity for southward expansion",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "tag": "religious_legitimacy",
      "layer": "ideology_religion",
      "description": "The Asturian court developed the ideology of 'neo-Gothicism', the kingdom as the legitimate heir of the Visigothic Christian kingdom, which gave the Reconquista its ideological framework; the Santiago de Compostela pilgrimage drew pan-Christian support",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "tag": "cantabrian_mountain_refuge",
      "layer": "military_security",
      "description": "The Cantabrian and Asturian mountains provided a near-impregnable refuge from Muslim armies; the terrain allowed the Visigothic remnant kingdom to survive and consolidate while Al-Andalus focused on more accessible lowland territories",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "tag": "battle_covadonga_legitimacy",
      "layer": "ideology_religion",
      "description": "Pelayo's victory at Covadonga (718 or 722) became the founding myth of Christian Iberian reconquest; the victory's narrative, miraculous divine intervention against the Muslim invader, gave Asturian kings a crusading mandate and priestly legitimacy",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "tag": "ideological_unification",
      "layer": "ideology_religion",
      "description": "Asturian kings claimed to be heirs of the Visigothic kingdom, presenting the Reconquista as restoration of a legitimate Christian monarchy; this ideology justified expansion, unified noble families of different origins, and attracted clergy who brought Visigothic legal traditions",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ],
      "tag_prose": "neogotico_ideology"
    },
    {
      "layer": "governance_institutional",
      "tag": "visigothic_succession_claim",
      "direction": "rise",
      "description": "Asturian kings claimed legitimate succession from the Visigothic monarchy, positioning themselves as the restorers of Iberian Christian civilization against Islamic rule. This legitimizing ideology framed the Reconquista as recovery of lost rights rather than new conquest.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "layer": "ideology_religion",
      "tag": "santiago_de_compostela_pilgrimage",
      "direction": "rise",
      "description": "The \"discovery\" of St. James's tomb at Santiago de Compostela (c.830) transformed the Asturian kingdom into the destination of Europe's premier pilgrimage. Pilgrimage traffic brought wealth, population, and Christian international solidarity to the kingdom.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    }
  ],
  "decline_factors": [
    {
      "tag": "succession_instability",
      "layer": "dynastic_legitimacy",
      "description": "Alfonso III's division of his kingdom among three sons upon his abdication (910) transformed Asturias into the Kingdom of León, effectively ending the Asturian state as the royal line moved to the more central capital",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "tag": "capital_shift_to_leon",
      "layer": "military_security",
      "description": "As the Reconquista pushed south, the political center of gravity shifted from Oviedo to León; Asturias became a peripheral northern region while the kingdom's identity transformed into the Kingdom of León, effectively ending the Asturian period even though the dynasty continued",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    },
    {
      "tag": "succession_crisis",
      "layer": "military_security",
      "description": "The Asturian kingdom suffered from the Visigothic tradition of elective monarchy applied to a de-facto dynastic state; disputes over succession (Alfonso II's contested enthronement, the rivalry between the sons of Ordoño I) drained military energy that could have been used for expansion",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ],
      "tag_prose": "succession_disputes"
    },
    {
      "layer": "governance_institutional",
      "tag": "leonese_succession_transformation",
      "direction": "decline",
      "description": "Alfonso III's expansion south to the Douro and transfer of the capital to León (910) effectively transformed Asturias into the Kingdom of León. The \"Asturian\" identity was progressively replaced by Leonese identity as the political center moved south.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q231392",
          "url": "https://www.wikidata.org/wiki/Q231392"
        },
        {
          "type": "wikipedia",
          "label": "Kingdom of Asturias",
          "url": "https://en.wikipedia.org/wiki/Kingdom_of_Asturias"
        }
      ]
    }
  ],
