  "lifecycle_phases": [
    {
      "phase": "establishment",
      "years": "1230–1340",
      "description": "Muhammad I ibn Nasr founds the Nasrid dynasty (1230) in the wake of Almohad collapse. As the Reconquista overruns al-Andalus, Granada survives by becoming a vassal of Castile while playing Christian and Moroccan powers against each other. The city of Granada expands rapidly as refugees from fallen Muslim cities flood in. The Alhambra palace complex begins construction (1238).",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q238445",
          "url": "https://www.wikidata.org/wiki/Q238445"
        },
        {
          "type": "wikipedia",
          "label": "Emirate of Granada",
          "url": "https://en.wikipedia.org/wiki/Emirate_of_Granada"
        }
      ]
    },
    {
      "phase": "golden_age",
      "years": "1340–1410",
      "description": "Granada reaches its cultural and political zenith. The Alhambra and Generalife gardens are completed, the finest Islamic architecture in Europe. Yusuf I (1333–1354) and Muhammad V (1354–1391, with interruption) create a sophisticated court. The Battle of Río Salado (1340) is the last major Marinid intervention from Africa; afterward Granada relies solely on diplomacy and its mountainous terrain.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q238445",
          "url": "https://www.wikidata.org/wiki/Q238445"
        },
        {
          "type": "wikipedia",
          "label": "Emirate of Granada",
          "url": "https://en.wikipedia.org/wiki/Emirate_of_Granada"
        }
      ]
    },
    {
      "phase": "final_resistance",
      "years": "1410–1492",
      "description": "Granada survives 80 more years through skillful diplomacy and the Reconquista kingdoms' internal quarrels. The civil war between the Banu Serraj and Nasrid factions eventually gives Ferdinand and Isabella the opportunity they need; the dynastic unification of Castile and Aragon (1479) creates the resources for a final campaign. Muhammad XII (Boabdil) surrenders Granada on January 2, 1492, ending 781 years of Islamic rule in Iberia.",
      "sources": [
        {
          "type": "wikidata",
          "id": "Q238445",
          "url": "https://www.wikidata.org/wiki/Q238445"
        },
        {
          "type": "wikipedia",
          "label": "Emirate of Granada",
          "url": "https://en.wikipedia.org/wiki/Emirate_of_Granada"
        }
      ]
    }
  ],
  "rise_factors": [
    {
      "tag": "geographic_defensibility",
      "layer": "geography_territory",
      "description": "The Sierra Nevada and surrounding mountain ranges made Granada extremely difficult to conquer by conventional means; the kingdom's terrain channeled attackers into defensible passes and denied Castilian cavalry the open fields where they excelled",
      "sources": [
        {
          "type": "wikidata",
