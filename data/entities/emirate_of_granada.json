        }
      ]
    },
    {
      "layer": "governance_institutional",
      "tag": "internal_fragmentation",
      "direction": "decline",
      "description": "The 1480s saw catastrophic Nasrid dynastic conflict: Abu al-Hasan Ali, his brother Muhammad al-Zaghal, and his son Boabdil fought a three-way civil war that allowed Ferdinand and Isabella to pick off fortresses piecemeal.",
